# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# MongoDB Atlas connection string.
#   • Percent-encode special characters in the password (@ → %40, : → %3A, etc.).
#   • Include a database name in the path (here: aurora_health).
# Get yours from Atlas → Cluster → Connect → Drivers.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/aurora_health?retryWrites=true&w=majority&appName=Cluster0"

# ---------------------------------------------------------------------------
# SMS OTP (patient phone login)
# ---------------------------------------------------------------------------
# Provider for one-time-passcode texts. Supported: "fast2sms" (default).
# Leave the API key blank to run in DEV MODE — no SMS is sent and the code is
# logged to the server console (and echoed to the login UI) so you can test the
# flow without a paid account.
SMS_PROVIDER="fast2sms"
# Fast2SMS API key — Fast2SMS dashboard → Dev API → API Key. Indian numbers only.
FAST2SMS_API_KEY=""

# ---------------------------------------------------------------------------
# Email OTP (patient email login)
# ---------------------------------------------------------------------------
# Provider for one-time-passcode emails:
#   • "smtp"   — any SMTP server via nodemailer. With Gmail you can email ANY
#                recipient from your own Gmail using a Google App Password (no
#                domain to verify) — best free option for small/demo volumes.
#   • "resend" — HTTP API; needs a verified domain to email arbitrary addresses.
# Leave the provider's credentials blank to run in DEV MODE (code logged to the
# server console + echoed to the login UI, nothing sent).
EMAIL_PROVIDER="smtp"
# Sender. For Gmail SMTP this must be your Gmail address (Gmail rewrites it anyway).
EMAIL_FROM="Aurora Health <you@gmail.com>"

# --- Gmail SMTP ---
# SMTP_PASS is a 16-char Google App Password (NOT your Gmail login password):
#   1) Turn on 2-Step Verification: https://myaccount.google.com/security
#   2) Create an App Password:       https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS=""

# --- Resend (alternative) ---
# Resend API key — https://resend.com → API Keys. Needs a verified domain.
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# Session auth
# ---------------------------------------------------------------------------
# Secret that signs session cookies (HS256 JWT). Use a long random value and
# keep it out of source control. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
